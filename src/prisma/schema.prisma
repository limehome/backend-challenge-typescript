datasource db {
  provider = "sqlite"
}

generator client {
  provider               = "prisma-client"
  output                 = "../../generated/prisma"
  importFileExtension    = "ts"
}

model Booking {
  id             Int     @id @default(autoincrement())
  guestName      String
  unitID         String
  checkInDate    DateTime
  numberOfNights Int
}
